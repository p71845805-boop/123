-- ===================================================================
-- SILENT AIM SYSTEM
-- ===================================================================
local SilentAim = {
    FOV = Drawing.new("Circle"),
    Target = nil,
    HeadCache = {},
    HeadSet = {}
}

-- Setup FOV Circle
SilentAim.FOV.Filled = false
SilentAim.FOV.NumSides = 64
SilentAim.FOV.Thickness = 1.5
SilentAim.FOV.Visible = false

-- Cache heads for performance
local function addHead(part)
    if part:IsA("BasePart") and (part.Name == "Head" or part.Name == "HumanoidRootPart") then
        local parent = part.Parent
        if parent and parent:IsA("Model") and parent:FindFirstChild("Humanoid") then
            if not SilentAim.HeadSet[part] then
                SilentAim.HeadSet[part] = true
                table.insert(SilentAim.HeadCache, part)
            end
        end
    end
end

local function removeHead(part)
    if SilentAim.HeadSet[part] then
        SilentAim.HeadSet[part] = nil
        for i = #SilentAim.HeadCache, 1, -1 do
            if SilentAim.HeadCache[i] == part then
                table.remove(SilentAim.HeadCache, i)
                break
            end
        end
    end
end

-- Populate cache
for _, desc in ipairs(Workspace:GetDescendants()) do
    addHead(desc)
end

Workspace.DescendantAdded:Connect(addHead)
Workspace.DescendantRemoving:Connect(removeHead)

-- Visibility check
local function isVisible(targetPart)
    if not WeaponSystem.Features.SilentAim.VisibleCheck then return true end
    
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit * 1000
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    local result = Workspace:Raycast(origin, direction, raycastParams)
    
    if result then
        local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
        if hitModel and hitModel:FindFirstChild("Humanoid") then
            return hitModel == targetPart.Parent
        end
        return false
    end
    
    return true
end

-- Team check
local function isEnemy(character)
    if not WeaponSystem.Features.SilentAim.TeamCheck then return true end
    
    local player = Players:GetPlayerFromCharacter(character)
    if not player then return false end
    
    return player.Team ~= LocalPlayer.Team
end

-- Get target
function SilentAim:GetTarget()
    local config = WeaponSystem.Features.SilentAim
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    local closestDist = math.huge
    local target = nil
    
    for i = #self.HeadCache, 1, -1 do
        local part = self.HeadCache[i]
        if not part or not part.Parent then
            table.remove(self.HeadCache, i)
            self.HeadSet[part] = nil
            continue
        end
        
        local character = part.Parent
        if character == LocalPlayer.Character then continue end
        if not isEnemy(character) then continue end
        
        -- Check if correct part
        if part.Name ~= config.TargetPart then
            -- Fallback to HRP if head missing
            if config.TargetPart == "Head" and not part.Parent:FindFirstChild("Head") then
                part = part.Parent:FindFirstChild("HumanoidRootPart")
                if not part then continue end
            else
                continue
            end
        end
        
        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen or pos.Z <= 0 then continue end
        
        local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
        if dist > config.FOV then continue end
        
        if not isVisible(part) then continue end
        
        if dist < closestDist then
            closestDist = dist
            target = part
        end
    end
    
    return target
end

-- Update FOV circle
RunService.RenderStepped:Connect(function()
    local config = WeaponSystem.Features.SilentAim
    
    SilentAim.FOV.Visible = config.Enabled and config.ShowFOV
    SilentAim.FOV.Radius = config.FOV
    SilentAim.FOV.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    SilentAim.FOV.Color = config.Color
    SilentAim.FOV.Thickness = config.Thickness
    
    if config.Enabled then
        SilentAim.Target = SilentAim:GetTarget()
    else
        SilentAim.Target = nil
    end
end)

