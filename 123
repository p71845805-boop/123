local function createTab(name, icon)
    local btn = Instance.new("TextButton")
    btn.Name = name.."Tab"
    btn.Size = UDim2.new(0, 100, 1, 0)
    btn.BackgroundColor3 = theme.GroupBackground
    btn.BorderColor3 = theme.Border
    btn.BorderSizePixel = 1
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = "  "..name
    btn.TextColor3 = theme.TextDim
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = tabsContainer
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = btn
    
    local indicator = Instance.new("Frame")
    indicator.Name = "Indicator"
    indicator.Size = UDim2.new(0, 3, 0.6, 0)
    indicator.Position = UDim2.new(0, 0, 0.2, 0)
    indicator.BackgroundColor3 = theme.Accent
    indicator.BorderSizePixel = 0
    indicator.Visible = false
    indicator.Parent = btn
    
    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(0, 2)
    indCorner.Parent = indicator
    
    local page = Instance.new("ScrollingFrame")
    page.Name = name.."Page"
    page.Size = UDim2.new(1, -20, 1, -90)
    page.Position = UDim2.new(0, 10, 0, 84)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = theme.Accent
    page.Visible = false
    page.Parent = mainWindow
    
    pages[name] = page
    tabButtons[name] = {Button = btn, Indicator = indicator}
    
    btn.MouseButton1Click:Connect(function()
        for n, p in pairs(pages) do
            p.Visible = (n == name)
            local elems = tabButtons[n]
            elems.Button.TextColor3 = (n == name) and theme.Text or theme.TextDim
            elems.Button.BorderColor3 = (n == name) and theme.Accent or theme.Border
            elems.Indicator.Visible = (n == name)
        end
    end)
    
    return page
end

