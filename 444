-- Hook BulletService
local success, BulletService = pcall(function()
    return require(BulletServicePath)
end)

if success and BulletService then
    local oldDischarge = hookfunction(BulletService.Discharge, newcclosure(function(self, originCFrame, ...)
        if WeaponSystem.Features.SilentAim.Enabled and SilentAim.Target then
            local targetPos = SilentAim.Target.Position
            
            -- Prediction if needed
            if WeaponSystem.Features.SilentAim.Prediction then
                local velocity = SilentAim.Target.AssemblyLinearVelocity or Vector3.new()
                targetPos = targetPos + (velocity * 0.05)
            end
            
            originCFrame = CFrame.new(originCFrame.Position, targetPos)
        end
        
        -- No spread modification
        if WeaponSystem.Features.NoSpread.Enabled then
            -- Remove random spread from origin
            local args = {...}
            if args[1] and typeof(args[1]) == "Vector3" then
                args[1] = originCFrame.LookVector * 1000 -- Perfect direction
            end
            return oldDischarge(self, originCFrame, unpack(args))
        end
        
        return oldDischarge(self, originCFrame, ...)
    end))
    
    print("✓ BulletService hooked")
end

-- Hook GunClass
local oldGunNew = GunClass.new
GunClass.new = newcclosure(function(tool, ...)
    local gun = oldGunNew(tool, ...)
    
    -- Store original values
    local originalRPM = gun.Config.RPM
    local originalSpreadStart = gun.SpreadStart
    local originalSpreadMax = gun.SpreadMax
    local originalSpreadIncrease = gun.SpreadIncrease
    local originalRecoil = table.clone(gun.Config.Recoil)
    
    -- Rapid Fire
    spawn(function()
        while gun and gun.Tool and gun.Tool.Parent do
            if WeaponSystem.Features.RapidFire.Enabled then
                gun.Config.RPM = originalRPM * WeaponSystem.Features.RapidFire.Multiplier
            else
                gun.Config.RPM = originalRPM
            end
            RunService.Heartbeat:Wait()
        end
    end)
    
    -- No Spread
    spawn(function()
        while gun and gun.Tool and gun.Tool.Parent do
            if WeaponSystem.Features.NoSpread.Enabled then
                gun.SpreadStart = 0
                gun.SpreadMax = {
                    StillStanding = 0,
                    StillCrouching = 0,
                    MoveStanding = 0,
                    MoveCrouching = 0
                }
                gun.SpreadIncrease = 0
                
                if WeaponSystem.Features.NoSpread.NoRecoil then
                    gun.Config.Recoil = {
                        Vertical = 0,
                        Horizontal = 0,
                        Depth = 0
                    }
                end
            else
                gun.SpreadStart = originalSpreadStart
                gun.SpreadMax = originalSpreadMax
                gun.SpreadIncrease = originalSpreadIncrease
                gun.Config.Recoil = originalRecoil
            end
            RunService.Heartbeat:Wait()
        end
    end)
    
    -- Force Automatic
    spawn(function()
        while gun and gun.Tool and gun.Tool.Parent do
            if WeaponSystem.Features.Misc.AutomaticMode then
                gun.FireMode = "Auto"
                gun.Config.FireModes = {"Auto"}
            end
            RunService.Heartbeat:Wait()
        end
    end)
    
    -- Infinite Ammo
    spawn(function()
        while gun and gun.Tool and gun.Tool.Parent do
            if WeaponSystem.Features.Misc.InfiniteAmmo then
                if gun.Ammo then
                    gun.Ammo.Value = 999
                end
                if gun.Spare then
                    gun.Spare.Value = 999
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
    
    -- Instant Reload
    local oldReload = gun.Reload
    gun.Reload = newcclosure(function(self, ...)
        if WeaponSystem.Features.RapidFire.InstantReload then
            if self.Ammo and self.Ammo:GetAttribute("Max") then
                self.Ammo.Value = self.Ammo:GetAttribute("Max")
                return
            end
        end
        return oldReload(self, ...)
    end)
    
    -- Damage Multiplier (server-side dependent but we try)
    local oldFire = gun.Fire
    gun.Fire = newcclosure(function(self, ...)
        if WeaponSystem.Features.Misc.DamageMultiplier > 1 then
            -- Store multiplier for bullet data
            self._DamageMultiplier = WeaponSystem.Features.Misc.DamageMultiplier
        end
        return oldFire(self, ...)
    end)
    
    print("✓ GunClass hooked for", tool.Name)
    return gun
end)

